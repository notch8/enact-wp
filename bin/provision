#!/usr/bin/env python3
"""Provision an Enact WordPress instance from content/ over the REST API.

Create-only by default: an item that already exists (matched by slug) is
skipped and reported, never modified. Works against any environment:

    bin/provision --base-url http://localhost:8080 --user admin --app-password 'xxxx xxxx ...'

Overwriting an existing item needs an explicit --overwrite SECTION[,SECTION],
e.g. the brand rollout:

    bin/provision --base-url ... --user ... --app-password '...' \
        --only media,fonts,template-parts,global-styles,site-branding \
        --overwrite template-parts,global-styles,site-branding

Add --dry-run to list what would be created, overwritten, skipped or deleted
without writing anything.

Uses only the Python 3 standard library. The REST API is reached via
?rest_route= so it works before and after pretty permalinks are enabled.
This script never creates, modifies or deletes WordPress users -- users are
managed in wp-admin. The post author (post_author in site.json) must already
exist; the script looks it up and fails if it doesn't.

--only SECTION[,SECTION...] applies a subset of sections instead of the whole
seed. This is how changes are deployed to an environment where editors own the
content: it never touches pages, posts or navigation unless asked to. Sections:
media, fonts, pages, posts, navigation, template-parts, templates,
global-styles, site-branding (site icon + logo only), settings, cleanup.

--overwrite SECTION[,SECTION...] allows writes to existing items within the
sections named (from: media, pages, posts, navigation, template-parts,
templates, global-styles, site-branding, settings, cleanup). Sections not
named there are create-only: existing items are left untouched and reported.
"""
import argparse, base64, json, mimetypes, re, secrets, sys, urllib.error, urllib.parse, urllib.request
from pathlib import Path

CONTENT = Path(__file__).resolve().parent.parent / "content"

SECTIONS = ["media", "fonts", "pages", "posts", "navigation", "template-parts",
            "templates", "global-styles", "site-branding", "settings", "cleanup"]

OVERWRITABLE = ["media", "pages", "posts", "navigation", "template-parts",
                "templates", "global-styles", "site-branding", "settings", "cleanup"]

def log(msg): print(msg, flush=True)

class WP:
    def __init__(self, base, user, password):
        self.base = base.rstrip("/")
        token = base64.b64encode(f"{user}:{password}".encode()).decode()
        self.auth = f"Basic {token}"

    def url(self, route, params=None):
        q = {"rest_route": route}
        if params: q.update(params)
        # Cache-buster: some edges (Cloudflare) can serve stale GETs, which
        # breaks the find-then-create idempotency checks.
        q["_cb"] = secrets.token_hex(4)
        return f"{self.base}/?{urllib.parse.urlencode(q)}"

    def req(self, method, route, params=None, body=None, headers=None, raw=None):
        h = {"Authorization": self.auth, "User-Agent": "enact-provisioner/1.0",
             "Cache-Control": "no-cache", "Pragma": "no-cache"}
        data = None
        if raw is not None:
            data = raw
        elif body is not None:
            data = json.dumps(body).encode()
            h["Content-Type"] = "application/json"
        if headers: h.update(headers)
        r = urllib.request.Request(self.url(route, params), data=data, method=method, headers=h)
        try:
            with urllib.request.urlopen(r, timeout=120) as resp:
                return json.loads(resp.read().decode() or "null")
        except urllib.error.HTTPError as e:
            detail = e.read().decode()[:500]
            raise RuntimeError(f"{method} {route} -> HTTP {e.code}: {detail}") from None

    def get(self, route, params=None): return self.req("GET", route, params)
    def post(self, route, body=None, params=None, **kw): return self.req("POST", route, params, body, **kw)
    def delete(self, route, params=None): return self.req("DELETE", route, params)

    def post_form(self, route, fields):
        data = urllib.parse.urlencode(fields).encode()
        return self.req("POST", route, raw=data,
                        headers={"Content-Type": "application/x-www-form-urlencoded"})

    def post_multipart(self, route, fields, files):
        boundary = "----enactwp" + secrets.token_hex(8)
        parts = []
        for k, v in fields.items():
            parts.append((f'--{boundary}\r\nContent-Disposition: form-data; '
                          f'name="{k}"\r\n\r\n{v}\r\n').encode())
        for k, (fname, data, ctype) in files.items():
            parts.append((f'--{boundary}\r\nContent-Disposition: form-data; '
                          f'name="{k}"; filename="{fname}"\r\n'
                          f'Content-Type: {ctype}\r\n\r\n').encode() + data + b"\r\n")
        parts.append(f"--{boundary}--\r\n".encode())
        return self.req("POST", route, raw=b"".join(parts),
                        headers={"Content-Type": f"multipart/form-data; boundary={boundary}"})

def find_by_slug(wp, route, slug, extra=None):
    params = {"slug": slug, "per_page": 100, "context": "edit"}
    if extra: params.update(extra)
    items = wp.get(route, params)
    return items[0] if items else None

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--base-url", required=True)
    ap.add_argument("--user", required=True)
    ap.add_argument("--app-password", required=True)
    ap.add_argument("--only", help="comma-separated subset of sections to apply: " + ",".join(SECTIONS))
    ap.add_argument("--overwrite", help="comma-separated sections allowed to overwrite/delete existing items: " + ",".join(OVERWRITABLE))
    ap.add_argument("--dry-run", action="store_true", help="report what would be created, overwritten, skipped or deleted, without writing")
    args = ap.parse_args()
    dry = args.dry_run

    if args.only:
        selected = {s.strip() for s in args.only.split(",") if s.strip()}
        unknown = selected - set(SECTIONS)
        if unknown:
            sys.exit(f"unknown --only sections: {', '.join(sorted(unknown))}")
        # global styles reference uploaded font URLs, so fonts must resolve first
        if "global-styles" in selected:
            selected.add("fonts")
    else:
        # site-branding is a subset of settings; full runs cover it there
        selected = set(SECTIONS) - {"site-branding"}
    def want(s): return s in selected

    overwrite = set()
    if args.overwrite:
        overwrite = {s.strip() for s in args.overwrite.split(",") if s.strip()}
        unknown = overwrite - set(OVERWRITABLE)
        if unknown:
            sys.exit(f"unknown --overwrite sections: {', '.join(sorted(unknown))}")
    def may_overwrite(s): return s in overwrite

    wp = WP(args.base_url, args.user, args.app_password)
    site = json.loads((CONTENT / "site.json").read_text())
    me = wp.get("/wp/v2/users/me")
    log(f"Authenticated as {me['name']} on {args.base_url}" + (" (dry run)" if dry else ""))

    # --- media -------------------------------------------------------------
    media_ids, media_urls = {}, {}
    needs_media_map = want("media") or any(want(s) for s in
        ("pages", "posts", "template-parts", "templates", "site-branding", "settings"))
    if needs_media_map:
        for m in site["media"]:
            fname = m["file"]
            slug = Path(fname).stem.lower()
            existing = find_by_slug(wp, "/wp/v2/media", slug)
            if existing:
                item = existing
                if want("media"):
                    if may_overwrite("media"):
                        if dry:
                            log(f"  [dry-run] would overwrite media metadata: {fname}")
                        else:
                            wp.post(f"/wp/v2/media/{item['id']}", body={"alt_text": m["alt"], "title": m["title"]})
                            log(f"  overwrote media metadata: {fname}")
                    else:
                        log(f"  media {fname} exists, skipping (use --overwrite media to update metadata)")
            elif want("media"):
                if dry:
                    log(f"  [dry-run] would upload {fname}")
                    item = {"id": -1, "source_url": ""}
                else:
                    path = CONTENT / "media" / fname
                    ctype = mimetypes.guess_type(fname)[0] or "application/octet-stream"
                    item = wp.post("/wp/v2/media", raw=path.read_bytes(), headers={
                        "Content-Type": ctype,
                        "Content-Disposition": f'attachment; filename="{fname}"'})
                    wp.post(f"/wp/v2/media/{item['id']}", body={"alt_text": m["alt"], "title": m["title"]})
                    log(f"  uploaded {fname} (id {item['id']})")
            else:
                continue  # read-only map for substitution; skip missing items
            media_ids[fname] = item["id"]
            media_urls[fname] = item.get("source_url", "")
        log(f"Media ready: {len(media_ids)} items")

    # --- fonts -------------------------------------------------------------
    font_urls = {}
    if want("fonts"):
        for fam in site.get("fonts", []):
            existing = wp.get("/wp/v2/font-families", {"slug": fam["slug"], "per_page": 100})
            if existing:
                fam_id = existing[0]["id"]
            elif dry:
                log(f"  [dry-run] would create font family {fam['slug']}")
                fam_id = -1
            else:
                fam_settings = json.dumps({"name": fam["name"], "slug": fam["slug"],
                                           "fontFamily": fam["fontFamily"]})
                fam_id = wp.post_form("/wp/v2/font-families",
                                      {"font_family_settings": fam_settings})["id"]
                log(f"  created font family {fam['slug']} (id {fam_id})")
            faces = wp.get(f"/wp/v2/font-families/{fam_id}/font-faces", {"per_page": 100}) if fam_id != -1 else []
            have = {}
            for f in faces:
                s = f.get("font_face_settings", {})
                have[(s.get("fontStyle", "normal"), str(s.get("fontWeight", "400")))] = s
            for face in fam["faces"]:
                key = (face["fontStyle"], str(face["fontWeight"]))
                if key in have:
                    src = have[key].get("src")
                elif dry:
                    log(f"  [dry-run] would upload font face {face['file']}")
                    src = ""
                else:
                    fs = json.dumps({"fontFamily": fam["name"], "fontStyle": face["fontStyle"],
                                     "fontWeight": face["fontWeight"], "src": ["file-0"]})
                    data = (CONTENT / "fonts" / face["file"]).read_bytes()
                    resp = wp.post_multipart(f"/wp/v2/font-families/{fam_id}/font-faces",
                                             fields={"font_face_settings": fs},
                                             files={"file-0": (face["file"], data, "font/woff2")})
                    src = resp["font_face_settings"]["src"]
                    log(f"  uploaded font face {face['file']}")
                if isinstance(src, list): src = src[0]
                font_urls[face["file"]] = src
        log(f"Fonts ready: {len(font_urls)} faces")

    def substitute(text):
        for fname, mid in media_ids.items():
            text = text.replace("{{media_id:%s}}" % fname, str(mid))
            text = text.replace("{{media_url:%s}}" % fname, media_urls[fname])
        for fname, url in font_urls.items():
            text = text.replace("{{font_url:%s}}" % fname, url)
        return text

    # --- pages -------------------------------------------------------------
    page_ids = {}
    if want("pages"):
        for p in site["pages"]:
            content = substitute((CONTENT / p["file"]).read_text())
            body = {"title": p["title"], "slug": p["slug"], "status": "publish",
                    "content": content, "comment_status": "closed", "ping_status": "closed"}
            if p.get("parent"): body["parent"] = page_ids[p["parent"]]
            if p.get("template"): body["template"] = p["template"]
            existing = find_by_slug(wp, "/wp/v2/pages", p["slug"])
            if existing:
                page_ids[p["slug"]] = existing["id"]
                if may_overwrite("pages"):
                    if dry:
                        log(f"  [dry-run] would overwrite page {p['slug']}")
                    else:
                        wp.post(f"/wp/v2/pages/{existing['id']}", body=body)
                        log(f"  overwrote page {p['slug']} (id {existing['id']})")
                else:
                    log(f"  page {p['slug']} exists, skipping (use --overwrite pages to update)")
            elif dry:
                log(f"  [dry-run] would create page {p['slug']}")
                page_ids[p["slug"]] = -1
            else:
                item = wp.post("/wp/v2/pages", body=body)
                page_ids[p["slug"]] = item["id"]
                log(f"  created page {p['slug']} (id {item['id']})")

    def page_id(slug):
        if slug not in page_ids:
            it = find_by_slug(wp, "/wp/v2/pages", slug)
            if not it: raise RuntimeError(f"page {slug} not found on the site")
            page_ids[slug] = it["id"]
        return page_ids[slug]

    # --- category + tags ----------------------------------------------------
    def ensure_term(route, name):
        found = wp.get(route, {"search": name, "per_page": 100})
        for t in found:
            if t["name"].lower() == name.lower(): return t["id"]
        try:
            return wp.post(route, body={"name": name})["id"]
        except RuntimeError as e:
            m = re.search(r'"term_id":(\d+)', str(e))
            if m: return int(m.group(1))
            raise

    # --- posts ---------------------------------------------------------------
    if want("posts"):
        author = site["post_author"]
        users = wp.get("/wp/v2/users", {"search": author["username"], "context": "edit"})
        match = [u for u in users if u.get("username") == author["username"] or u.get("slug") == author["username"]]
        if match:
            author_id = match[0]["id"]
        elif dry:
            author_id = None
            log(f"  [dry-run] author user '{author['username']}' not found; create it in wp-admin before a real run")
        else:
            sys.exit(f"author user '{author['username']}' not found. Users are managed in wp-admin -- "
                     f"create it there first, then re-run.")

        for p in site["posts"]:
            content = substitute((CONTENT / p["file"]).read_text())
            def post_body():
                return {"title": p["title"], "slug": p["slug"], "status": "publish",
                        "content": content, "date": p["date"],
                        "categories": [ensure_term("/wp/v2/categories", p["category"])],
                        "tags": [ensure_term("/wp/v2/tags", t) for t in p["tags"]],
                        "author": author_id, "comment_status": "closed",
                        "ping_status": "closed"}
            existing = find_by_slug(wp, "/wp/v2/posts", p["slug"])
            if existing:
                if may_overwrite("posts"):
                    if dry:
                        log(f"  [dry-run] would overwrite post {p['slug']}")
                    else:
                        wp.post(f"/wp/v2/posts/{existing['id']}", body=post_body())
                        log(f"  overwrote post {p['slug']} (id {existing['id']})")
                else:
                    log(f"  post {p['slug']} exists, skipping (use --overwrite posts to update)")
            elif dry:
                log(f"  [dry-run] would create post {p['slug']}")
            else:
                item = wp.post("/wp/v2/posts", body=post_body())
                log(f"  created post {p['slug']} (id {item['id']})")

    # --- navigation ----------------------------------------------------------
    if want("navigation"):
        def nav_link(entry, inner=""):
            pid = page_id(entry["page"])
            pg = find_by_slug(wp, "/wp/v2/pages", entry["page"])
            url = pg["link"] if pg else f"{wp.base}/?page_id={pid}"
            attrs = json.dumps({"label": entry["label"], "type": "page", "id": pid,
                                "url": url, "kind": "post-type"})
            if inner:
                return (f'<!-- wp:navigation-submenu {attrs} -->{inner}<!-- /wp:navigation-submenu -->')
            return f'<!-- wp:navigation-link {attrs} /-->'

        nav_markup = ""
        for entry in site["navigation"]:
            inner = "".join(nav_link(c) for c in entry.get("children", []))
            nav_markup += nav_link(entry, inner)

        existing = find_by_slug(wp, "/wp/v2/navigation", "main-navigation")
        nav_body = {"title": "Main Navigation", "slug": "main-navigation",
                    "status": "publish", "content": nav_markup}
        if existing:
            if may_overwrite("navigation"):
                if dry:
                    log("  [dry-run] would overwrite navigation")
                else:
                    wp.post(f"/wp/v2/navigation/{existing['id']}", body=nav_body)
                    log("Navigation overwritten")
            else:
                log("  navigation exists, skipping (use --overwrite navigation to update)")
        elif dry:
            log("  [dry-run] would create navigation")
        else:
            wp.post("/wp/v2/navigation", body=nav_body)
            log("Navigation created")

    # --- template parts --------------------------------------------------------
    if want("template-parts"):
        for part, fname in site.get("template_parts", {}).items():
            if not may_overwrite("template-parts"):
                log(f"  template part {part} exists, skipping (use --overwrite template-parts to update)")
                continue
            if dry:
                log(f"  [dry-run] would overwrite template part {part}")
                continue
            content = substitute((CONTENT / fname).read_text())
            theme = wp.get("/wp/v2/themes", {"status": "active"})[0]["stylesheet"]
            part_id = f"{theme}//{part}"
            wp.post(f"/wp/v2/template-parts/{part_id}", body={"content": content})
            log(f"  template part {part_id} updated")

    # --- templates ---------------------------------------------------------------
    if want("templates"):
        for tpl, fname in site.get("templates", {}).items():
            if not may_overwrite("templates"):
                log(f"  template {tpl} exists, skipping (use --overwrite templates to update)")
                continue
            if dry:
                log(f"  [dry-run] would overwrite template {tpl}")
                continue
            content = substitute((CONTENT / fname).read_text())
            theme = wp.get("/wp/v2/themes", {"status": "active"})[0]["stylesheet"]
            tpl_id = f"{theme}//{tpl}"
            wp.post(f"/wp/v2/templates/{tpl_id}", body={"content": content})
            log(f"  template {tpl_id} updated")

    # --- global styles ----------------------------------------------------------
    if want("global-styles"):
        gs_file = site.get("global_styles")
        if gs_file:
            if not may_overwrite("global-styles"):
                log("  global styles exist, skipping (use --overwrite global-styles to update)")
            elif dry:
                log("  [dry-run] would overwrite global styles")
            else:
                theme = wp.get("/wp/v2/themes", {"status": "active"})[0]
                href = theme["_links"]["wp:user-global-styles"][0]["href"]
                gs_id = href.rstrip("/").split("/")[-1]
                gs = json.loads(substitute((CONTENT / gs_file).read_text()))
                wp.post(f"/wp/v2/global-styles/{gs_id}", body=gs)
                log("Global styles applied")

    # --- site branding (icon + logo only, without the rest of settings) ---------
    if want("site-branding") and not want("settings"):
        if not (may_overwrite("site-branding") or may_overwrite("settings")):
            log("  site branding exists, skipping (use --overwrite site-branding to update)")
        else:
            body = {}
            if site.get("site_icon_media"): body["site_icon"] = media_ids[site["site_icon_media"]]
            if site.get("site_logo_media"): body["site_logo"] = media_ids[site["site_logo_media"]]
            if body:
                if dry:
                    log("  [dry-run] would overwrite site branding (icon/logo)")
                else:
                    wp.post("/wp/v2/settings", body=body)
                    log("Site branding (icon/logo) applied")

    # --- settings ------------------------------------------------------------
    if want("settings"):
        if not may_overwrite("settings"):
            log("  settings exist, skipping (use --overwrite settings to update)")
        else:
            settings = dict(site["settings"])
            settings["show_on_front"] = "page"
            settings["page_on_front"] = page_id(site["front_page"])
            settings["page_for_posts"] = page_id(site["posts_page"])
            icon = site.get("site_icon_media")
            if icon: settings["site_icon"] = media_ids[icon]
            logo = site.get("site_logo_media")
            if logo: settings["site_logo"] = media_ids[logo]
            if dry:
                log("  [dry-run] would overwrite settings")
            else:
                wp.post("/wp/v2/settings", body=settings)
                log("Settings applied")

    # --- cleanup ---------------------------------------------------------------
    if want("cleanup"):
        if not may_overwrite("cleanup"):
            log("  cleanup skipped (use --overwrite cleanup to delete listed pages/posts/plugins)")
        else:
            cl = site.get("cleanup", {})
            for slug in cl.get("delete_page_slugs", []):
                it = find_by_slug(wp, "/wp/v2/pages", slug)
                if it and it["id"] not in page_ids.values():
                    if dry:
                        log(f"  [dry-run] would delete page {slug}")
                    else:
                        wp.delete(f"/wp/v2/pages/{it['id']}", {"force": "true"}); log(f"  deleted page {slug}")
            for slug in cl.get("delete_post_slugs", []):
                it = find_by_slug(wp, "/wp/v2/posts", slug)
                if it:
                    if dry:
                        log(f"  [dry-run] would delete post {slug}")
                    else:
                        wp.delete(f"/wp/v2/posts/{it['id']}", {"force": "true"}); log(f"  deleted post {slug}")
            try:
                plugins = wp.get("/wp/v2/plugins")
                for target in cl.get("delete_plugins", []):
                    for pl in plugins:
                        if pl["plugin"] == target and pl["status"] == "inactive":
                            if dry:
                                log(f"  [dry-run] would delete plugin {target}")
                            else:
                                wp.delete(f"/wp/v2/plugins/{target}")
                                log(f"  deleted plugin {target}")
            except RuntimeError as e:
                log(f"  plugin cleanup skipped: {e}")

    log("Dry run complete, nothing written." if dry else "Provisioning complete.")

if __name__ == "__main__":
    main()
