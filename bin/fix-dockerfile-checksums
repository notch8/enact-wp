#!/bin/sh

# Recomputes the checksums Dockerfile pins (Two Factor plugin, en_GB core
# language pack) from the versions/URLs actually written there, and corrects
# any that don't match -- nothing publishes these as a value Renovate (or a
# human bumping TWO_FACTOR_VERSION by hand) could just read, so this is the
# other half of keeping them pinned correctly. Exits non-zero (via set -e) if
# a download fails; otherwise the caller checks `git diff` to see whether
# anything actually changed.

set -eu

# Nothing to check yet on a branch mid-stack that hasn't picked up these
# pins at all (e.g. a Dockerfile with just FROM/LABEL, no Two Factor/
# language-pack ARGs), or no Dockerfile at all.
[ -f Dockerfile ] || exit 0

if command -v sha256sum >/dev/null 2>&1; then
    hash_cmd="sha256sum"
else
    hash_cmd="shasum -a 256"
fi

two_factor_version=$(sed -n 's/^ARG TWO_FACTOR_VERSION=//p' Dockerfile)
if [ -n "$two_factor_version" ]; then
    two_factor_zip=$(mktemp)
    curl -fsSL "https://downloads.wordpress.org/plugin/two-factor.${two_factor_version}.zip" -o "$two_factor_zip"
    expected_two_factor_sha256=$($hash_cmd "$two_factor_zip" | cut -d' ' -f1)
    rm "$two_factor_zip"
    current_two_factor_sha256=$(sed -n 's/^ARG TWO_FACTOR_SHA256=//p' Dockerfile)
    if [ "$expected_two_factor_sha256" != "$current_two_factor_sha256" ]; then
        sed -i.bak "s/^ARG TWO_FACTOR_SHA256=.*/ARG TWO_FACTOR_SHA256=${expected_two_factor_sha256}/" Dockerfile
        rm Dockerfile.bak
        echo "Updated TWO_FACTOR_SHA256 for ${two_factor_version}: ${expected_two_factor_sha256}"
    fi
fi

wp_version=$(sed -n 's/^ARG WP_VERSION=//p' Dockerfile)
if [ -n "$wp_version" ]; then
    lang_zip=$(mktemp)
    curl -fsSL "https://downloads.wordpress.org/translation/core/${wp_version}/en_GB.zip" -o "$lang_zip"
    expected_lang_sha256=$($hash_cmd "$lang_zip" | cut -d' ' -f1)
    rm "$lang_zip"
    current_lang_sha256=$(sed -n 's/^ARG WP_LANG_EN_GB_SHA256=//p' Dockerfile)
    if [ "$expected_lang_sha256" != "$current_lang_sha256" ]; then
        sed -i.bak "s/^ARG WP_LANG_EN_GB_SHA256=.*/ARG WP_LANG_EN_GB_SHA256=${expected_lang_sha256}/" Dockerfile
        rm Dockerfile.bak
        echo "Updated WP_LANG_EN_GB_SHA256 for ${wp_version}: ${expected_lang_sha256}"
    fi
fi
