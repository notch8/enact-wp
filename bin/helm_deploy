#!/bin/sh
if [ -z "$1" ] || [ -z "$2" ]
then
    echo './bin/helm_deploy RELEASE_NAME NAMESPACE'
    exit 1
fi
release_name="${1}"
namespace="${2}"

helm repo add bitnami https://charts.bitnami.com/bitnami

helm upgrade \
    --install \
    --atomic \
    --timeout 15m0s \
    $HELM_EXTRA_ARGS \
    --namespace="$namespace" \
    --create-namespace \
    "$release_name" \
    bitnami/wordpress
