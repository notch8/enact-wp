#!/usr/bin/env bash
# Functional checks for wordpress/files/mu-plugins/site-hardening.php, run
# with `docker compose exec wordpress php` (not `./bin/wp`): the `cli`
# service shares the WordPress core volume but not the mu-plugins bind mount,
# so it never loads this mu-plugin and would silently test nothing. The
# `wordpress` container is the only one that does, the same as production.
#
# Usage: docker compose up -d && ./bin/test-site-hardening
set -euo pipefail
cd "$(dirname "$0")/.."

wp() { ./bin/wp "$@"; }
exec_php() { docker compose exec -T wordpress php -r "$1"; }

if ! wp core is-installed 2>/dev/null; then
    wp core install --url=http://localhost:8080 --title=Enact \
        --admin_user=notch8-admin --admin_password=password \
        --admin_email=test@example.com --skip-email >/dev/null
fi
# Pretty permalinks, so author URLs are /author/<nicename>/ rather than
# ?author=N -- matching production/staging, and needed for check #2 below.
wp rewrite structure '/%postname%/' --hard >/dev/null
wp rewrite flush --hard >/dev/null

boot='define("WP_USE_THEMES", false); require("/var/www/html/wp-load.php"); require_once(ABSPATH . "wp-admin/includes/user.php");'

failures=0
check() {
    local name="$1" expected="$2" actual="$3"
    if [ "$actual" = "$expected" ]; then
        echo "PASS: $name"
    else
        echo "FAIL: $name (expected '$expected', got '$actual')"
        failures=$((failures + 1))
    fi
}

# 1. REST route matching must be case-insensitive, same as WP's own route
#    dispatch -- otherwise /wp/v2/Users bypasses the block anonymously.
status=$(exec_php "
$boot
\$request = new WP_REST_Request('GET', '/wp/v2/Users');
echo rest_do_request(\$request)->get_status();
")
check "anonymous GET /wp/v2/Users (mixed case) is blocked" "401" "$status"

# 2. Author links (theme bylines, oEmbed author_url) must not hand anonymous
#    visitors the account's user_nicename, which defaults to the login.
user_id=$(exec_php "
$boot
\$id = username_exists('nicename-leak-check') ?: wp_insert_user([
    'user_login' => 'nicename-leak-check', 'user_pass' => wp_generate_password(), 'role' => 'author',
]);
echo \$id;
")
author_link=$(exec_php "
$boot
wp_set_current_user(0);
echo get_author_posts_url($user_id);
")
case "$author_link" in
    */author/*) leaks="nicename-in-link" ;;
    *) leaks="no-nicename-in-link" ;;
esac
check "anonymous author link hides the login" "no-nicename-in-link" "$leaks"
exec_php "$boot wp_delete_user($user_id);" >/dev/null

# 3. The display-name fix must catch users created/renamed after the
#    one-time pass has already run, not just the ones that existed at deploy.
display_name=$(exec_php "
$boot
update_option('enact_hardening_display_names_fixed', true);
\$id = username_exists('late-arriving-user') ?: wp_insert_user([
    'user_login' => 'late-arriving-user', 'user_pass' => wp_generate_password(), 'role' => 'author',
]);
echo get_userdata(\$id)->display_name;
wp_delete_user(\$id);
")
check "a user created after the one-time fix still gets a generic display name" "Enact Editorial Team" "$display_name"

if [ "$failures" -gt 0 ]; then
    echo
    echo "$failures check(s) failed."
    exit 1
fi
echo
echo "All checks passed."
